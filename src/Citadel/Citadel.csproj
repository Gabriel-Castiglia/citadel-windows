<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Citadel</AssemblyName>
    <RootNamespace>Citadel</RootNamespace>
    <StartupObject>Citadel.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>citadel.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The single place where the version is set; scripts\build.ps1 and the installers read it from here. -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Citadel</Product>
    <Description>Local AI chat for Windows</Description>
    <Authors>Gabriel Castiglia</Authors>
    <Company>Gabriel Castiglia</Company>
    <Copyright>Copyright (C) 2026 Gabriel Castiglia</Copyright>
    <!-- The interface carries its own English and Spanish texts; no framework satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Debug data names source files from the repository root (/_/), not from the folder where it was built. -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))=/_/</PathMap>
    <!-- WPF0001: the Fluent theme (Application.ThemeMode) is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- "dotnet publish -c Release" produces a single self-contained Citadel.exe (no .NET install required). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon used by the windows and the About window. -->
    <Resource Include="citadel.ico" />
    <!-- The license travels next to the executable, outside the single-file bundle, so the About window can open it. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
